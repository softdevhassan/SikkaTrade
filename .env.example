# Mode: dev (simulation/fake money) or prod (live trading/real money)
APP_MODE=dev

# Binance API Credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Trading Configuration
COINS=BTC,ETH,DOGE
ALLOTED_USDT=10
PARALLEL_TRADES=10
MIN_SPOT_TRADE_USDT=0.1
MAX_SPOT_TRADE_USDT=2

# Risk Management
TAKE_PROFIT_PERCENT=0.3
STOP_LOSS_PERCENT=0.15

# Runtime Settings
MAX_RUNTIME_SECONDS=30
ANALYSIS_LIVE_SECONDS=5

# Technical Analysis
PREV_ANALYSIS_HOURS=48,24,12,6,1
RSI_OVERSOLD=85
RSI_OVERBOUGHT=95
MIN_VOLUME_MULTIPLIER=1.5
